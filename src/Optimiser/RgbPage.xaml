<UserControl x:Class="Optimiser.RgbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- A round colour to pick. The ring shows the colour that's on. -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Ring" CornerRadius="22" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Padding="4">
              <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Muted}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,28">
      <TextBlock Style="{StaticResource MutedText}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left"
                 Text="Every RGB app on this PC in one place. Pick a colour and Optimiser shows it on everything it can control, and keeps it there while it runs. Open an app to change its own effects." />

      <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="One colour everywhere" Style="{StaticResource PanelTitle}" />
          <WrapPanel x:Name="Swatches" />
          <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,16" />
          <DockPanel>
            <Button x:Name="HandBack" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="20,0,0,0"
                    Content="Hand back to each app" Click="OnHandBack"
                    ToolTip="Stop setting a colour, so each app goes back to its own lighting" />
            <Ellipse x:Name="SummaryDot" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"
                     Stroke="{StaticResource Line}" />
            <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Your RGB apps" Style="{StaticResource GroupTitle}" />
      <TextBlock x:Name="Note" Style="{StaticResource MutedText}" Margin="2,0,0,0" Text="Looking for RGB apps…" />
      <ItemsControl x:Name="AppList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="24,0,0,0"
                        VerticalAlignment="Center" Content="{Binding OpenText}" Click="OnOpen"
                        Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" FontSize="15" />
                    <Border Style="{StaticResource Badge}">
                      <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0"
                             MaxWidth="720" HorizontalAlignment="Left" LineHeight="19" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
