<UserControl x:Class="Optimiser.ShotTrainerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Orange fill up to a round knob, on the same track as the progress bars -->
    <Style x:Key="SliderPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Range" TargetType="Slider">
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22">
              <Border Height="6" CornerRadius="3" Background="{StaticResource Line}" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPart}" Background="{StaticResource Accent}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPart}" Background="Transparent" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="Knob" Width="18" Height="18" BorderBrush="{StaticResource Bg}">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource Accent}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="3" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Knob" Property="BorderBrush" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderName" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SliderHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,6,0,22" />
    </Style>
    <!-- A start or end handle on the Edit panel's timeline -->
    <Style x:Key="CutHandle" TargetType="Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Canvas.Top" Value="5" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="3" Background="{StaticResource Accent}" BorderBrush="{StaticResource Bg}" BorderThickness="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- One saved clip: picking it loads it into the player -->
    <Style x:Key="ClipRow" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Clips" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Bg}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Line}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Line}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,28">
      <TextBlock Style="{StaticResource MutedText}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left"
                 Text="Training-pack shots in Rocket League with Necto, a real AI bot, defending and challenging you. Changes here reach the game at the next shot, so you can tune it while you play." />

      <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Left" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TrainingTabButton" Style="{StaticResource Segment}" GroupName="TrainerTabs" Content="Training"
                       IsChecked="True" Checked="OnTab" />
          <RadioButton x:Name="ClipsTabButton" Style="{StaticResource Segment}" GroupName="TrainerTabs" Content="Clips" Checked="OnTab" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="TrainingTab">
        <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Shot trainer" Style="{StaticResource PanelTitle}" />
            <DockPanel>
              <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{StaticResource Muted}" />
              <TextBlock x:Name="State" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel x:Name="Buttons" Margin="0,18,0,0">
              <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="Start training" Click="OnStart"
                      ToolTip="Opens Rocket League with the trainer. If the game is already open, RLBot restarts it." />
              <Button Style="{StaticResource SecondaryButton}" Content="Launch Rocket League" Margin="10,0,0,0" Click="OnLaunch"
                      ToolTip="Opens Rocket League through Epic on its own, without the trainer" />
              <Button Style="{StaticResource SecondaryButton}" Content="Play a match" Margin="10,0,0,0" Click="OnMatch"
                      ToolTip="A normal 1v1 match against Necto, at the Bot skill below" />
              <Button Style="{StaticResource SecondaryButton}" Content="Leave training" Margin="10,0,0,0" Click="OnLeave"
                      ToolTip="Stops the trainer and reopens Rocket League normally, for online play. In game: Menu, then Y." />
              <Button Style="{StaticResource SecondaryButton}" Content="Retry shot" Margin="10,0,0,0" Click="OnRetry"
                      ToolTip="Same as clicking the right stick in game" />
              <Button Style="{StaticResource SecondaryButton}" Content="Next shot" Margin="10,0,0,0" Click="OnNext"
                      ToolTip="Same as D-pad right in game" />
              <Button Style="{StaticResource SecondaryButton}" Content="Save clip" Margin="10,0,0,0" Click="OnSave"
                      ToolTip="Saves the last few seconds as a video in Clips. Same as D-pad up in game." />
              <Button Style="{StaticResource SecondaryButton}" Content="Open folder" Margin="10,0,0,0" Click="OnFolder" />
            </WrapPanel>
            <TextBlock x:Name="Keys" Style="{StaticResource MutedText}" FontSize="13" Margin="0,14,0,0"
                       Text="In game: click the right stick to retry a shot, D-pad left and right to change shot, D-pad up to save a clip." />
            <Border x:Name="WithGameRow" Height="1" Background="{StaticResource Line}" Margin="0,20,0,16" />
            <StackPanel x:Name="WithGamePanel">
              <DockPanel>
                <CheckBox x:Name="WithGame" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="24,0,0,0" Click="OnWithGame"
                          AutomationProperties.Name="Start with Rocket League" />
                <StackPanel>
                  <TextBlock Text="Start with Rocket League" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" MaxWidth="720" HorizontalAlignment="Left"
                             Text="When you open Rocket League, the trainer starts too. RLBot reopens the game once to join it. Needs Optimiser running in the background." />
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,16,0,0">
                <CheckBox x:Name="WithShift" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="24,0,0,0" Click="OnWithShift"
                          AutomationProperties.Name="Open Shift with Rocket League" />
                <StackPanel>
                  <TextBlock Text="Open Shift with Rocket League" FontWeight="SemiBold" />
                  <TextBlock x:Name="ShiftNote" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" MaxWidth="720" HorizontalAlignment="Left"
                             Text="Shift opens when Rocket League starts (before it, from the buttons here) and closes when the game closes. Needs Optimiser running in the background." />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="Controls">
          <TextBlock Text="Difficulty" Style="{StaticResource GroupTitle}" />
          <Border Style="{StaticResource Panel}" Padding="22,20,22,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="40" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Skill, StringFormat='{}{0:0}'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Bot skill" />
                </DockPanel>
                <Slider x:Name="Skill" AutomationProperties.Name="Bot skill" Style="{StaticResource Range}" Tag="bot_skill" Minimum="0" Maximum="100" TickFrequency="5"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="How well Necto plays. Around 70 is a Plat or Diamond opponent." />

                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HeadStart, StringFormat='{}{0:0.0} s'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Bot reaction time" />
                </DockPanel>
                <Slider x:Name="HeadStart" AutomationProperties.Name="Bot reaction time" Style="{StaticResource Range}" Tag="head_start" Minimum="0" Maximum="2" TickFrequency="0.1"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="How long the bot waits in its net before it moves." />

                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Countdown, StringFormat='{}{0:0} s'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Countdown" />
                </DockPanel>
                <Slider x:Name="Countdown" AutomationProperties.Name="Countdown" Style="{StaticResource Range}" Tag="countdown" Minimum="0" Maximum="5" TickFrequency="1"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="The 3-2-1 before each shot, with the ball frozen." />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=BallSpeed, StringFormat='{}{0:0}%'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Ball speed" />
                </DockPanel>
                <Slider x:Name="BallSpeed" AutomationProperties.Name="Ball speed" Style="{StaticResource Range}" Tag="ball_speed" Minimum="50" Maximum="150" TickFrequency="5"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="How fast each shot is launched at you." />

                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShotTime, StringFormat='{}{0:0}%'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Time per shot" />
                </DockPanel>
                <Slider x:Name="ShotTime" AutomationProperties.Name="Time per shot" Style="{StaticResource Range}" Tag="shot_time" Minimum="50" Maximum="200" TickFrequency="10"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="More time makes it easier to score." />

                <DockPanel>
                  <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Variation, StringFormat='{}{0:0}%'}" />
                  <TextBlock Style="{StaticResource SliderName}" Text="Variation" />
                </DockPanel>
                <Slider x:Name="Variation" AutomationProperties.Name="Variation" Style="{StaticResource Range}" Tag="variation" Minimum="0" Maximum="100" TickFrequency="10"
                        ValueChanged="OnSlider" />
                <TextBlock Style="{StaticResource SliderHint}" Text="Moves each shot around a little, so it isn't the same every time." />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="Shots" Style="{StaticResource GroupTitle}" />
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,14"
                         Text="Pick the shots to practise. With none picked, you get all of them." />
              <UniformGrid x:Name="ShotList" Columns="2" />

              <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,16" />
              <UniformGrid Columns="2">
                <DockPanel Margin="0,0,40,12">
                  <CheckBox x:Name="RandomOrder" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSwitch" Tag="order"
                            AutomationProperties.Name="Random order" />
                  <TextBlock Text="Random order" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,40,12">
                  <CheckBox x:Name="Repeat" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSwitch" Tag="repeat"
                            AutomationProperties.Name="Repeat this shot" />
                  <TextBlock Text="Repeat this shot" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,40,12">
                  <CheckBox x:Name="ShowPath" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSwitch" Tag="show_path"
                            AutomationProperties.Name="Show ball path" />
                  <TextBlock Text="Show ball path" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,40,12">
                  <CheckBox x:Name="Replay" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSwitch" Tag="replay"
                            AutomationProperties.Name="Replay goals" ToolTip="Plays each goal back in game before the next shot" />
                  <TextBlock Text="Replay goals" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,40,12">
                  <CheckBox x:Name="InfiniteBoost" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSwitch" Tag="infinite_boost"
                            AutomationProperties.Name="Infinite boost" />
                  <TextBlock Text="Infinite boost" VerticalAlignment="Center" />
                </DockPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="ClipsTab" Visibility="Collapsed">
        <TextBlock x:Name="NoClips" Style="{StaticResource MutedText}" FontSize="13" Margin="0,20,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   Text="No clips yet. Press D-pad up in game, or Save clip on the Training tab, to keep the last few seconds as a video." />
        <Grid x:Name="ClipView" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="240" />
          </Grid.ColumnDefinitions>
          <StackPanel>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <Border Background="Black" CornerRadius="6" Height="340">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                              MediaOpened="OnOpened" MediaEnded="OnEnded" MouseLeftButtonDown="OnVideoClick" Cursor="Hand"
                              ToolTip="Double-click for full screen" />
              </Border>
              <Slider x:Name="Seek" Style="{StaticResource Range}" IsSnapToTickEnabled="False" Minimum="0" Maximum="1"
                      AutomationProperties.Name="Position in the clip" ValueChanged="OnSeek"
                      Thumb.DragStarted="OnScrubStart" Thumb.DragCompleted="OnScrubEnd" />
              <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="FavouriteButton" Style="{StaticResource SecondaryButton}" FontFamily="{StaticResource Icons}" Content="&#xE734;"
                          MinWidth="40" Click="OnFavourite" ToolTip="Favourite" AutomationProperties.Name="Favourite" />
                  <Button Style="{StaticResource SecondaryButton}" Content="Full screen" Margin="10,0,0,0" Click="OnFullScreen"
                          ToolTip="Space plays and pauses, arrows skip 5 s, Esc goes back" />
                  <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Content="Play" MinWidth="84" Margin="10,0,0,0" Click="OnPlay" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ClipName" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                  <TextBox x:Name="RenameBox" Style="{DynamicResource Field}" MaxLength="80" Visibility="Collapsed"
                           KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameDone" AutomationProperties.Name="Clip name" />
                  <TextBlock x:Name="ClipInfo" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
              </DockPanel>
              <WrapPanel Margin="0,14,0,0">
                <Button x:Name="EditButton" Style="{StaticResource SecondaryButton}" Content="Edit" Click="OnEdit"
                        ToolTip="Trim the clip and change its colours. The video file itself isn't changed." />
                <Button Style="{StaticResource SecondaryButton}" Content="Rename" Margin="10,0,0,0" Click="OnRename"
                        ToolTip="Renames the clip and its file. Enter saves, Esc cancels." />
                <Button Style="{StaticResource SecondaryButton}" Content="Delete" Margin="10,0,0,0" Click="OnDelete"
                        ToolTip="Moves the clip to the Recycle Bin" />
                <Button Style="{StaticResource SecondaryButton}" Content="Open folder" Margin="10,0,0,0" Click="OnClipsFolder" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border x:Name="EditPanel" Style="{StaticResource Panel}" Margin="0,20,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="UndoButton" Style="{StaticResource SecondaryButton}" FontFamily="{StaticResource Icons}" Content="&#xE7A7;" MinWidth="40"
                          Click="OnUndo" ToolTip="Undo" AutomationProperties.Name="Undo" />
                  <Button x:Name="RedoButton" Style="{StaticResource SecondaryButton}" FontFamily="{StaticResource Icons}" Content="&#xE7A6;" MinWidth="40"
                          Margin="8,0,0,0" Click="OnRedo" ToolTip="Redo" AutomationProperties.Name="Redo" />
                  <Button x:Name="ResetButton" Style="{StaticResource SecondaryButton}" Content="Reset" Margin="8,0,0,0" Click="OnReset"
                          ToolTip="Back to the clip as recorded. Save afterwards to put the original back in the file." />
                  <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Save" MinWidth="84" Margin="8,0,0,0" Click="OnSaveVideo"
                          ToolTip="Writes the edit into the clip's video. The recording is kept, so Reset still works." />
                </StackPanel>
                <TextBlock Text="Edit" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel>
                <TextBlock x:Name="TrimText" Style="{StaticResource SliderValue}" />
                <TextBlock Style="{StaticResource SliderName}" Text="Time" />
              </DockPanel>
              <!-- The whole recording: the orange band is the part kept, its handles drag the start and end -->
              <Grid x:Name="Timeline" Height="40" Margin="0,10,0,0" Background="Transparent" Cursor="Hand"
                    SizeChanged="OnTimelineSize" MouseLeftButtonDown="OnTimelineClick" ToolTip="Click to jump there; drag the handles to cut">
                <Border Height="8" CornerRadius="4" Background="{StaticResource Line}" VerticalAlignment="Center" Margin="6,0" />
                <Canvas x:Name="TimelineCanvas" Margin="6,0" ClipToBounds="False">
                  <Border x:Name="KeptBand" Height="8" CornerRadius="4" Background="{StaticResource Accent}" Opacity="0.6" Canvas.Top="16" />
                  <Rectangle x:Name="Playhead" Width="2" Height="30" Fill="{StaticResource Text}" Canvas.Top="5" IsHitTestVisible="False" />
                  <Thumb x:Name="InHandle" Style="{StaticResource CutHandle}" Tag="in" DragStarted="OnHandleStart" DragDelta="OnHandleDrag"
                         AutomationProperties.Name="Start of the cut" />
                  <Thumb x:Name="OutHandle" Style="{StaticResource CutHandle}" Tag="out" DragStarted="OnHandleStart" DragDelta="OnHandleDrag"
                         AutomationProperties.Name="End of the cut" />
                </Canvas>
              </Grid>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="ShotTrim" Style="{StaticResource AccentButton}" Content="Cut to the shot" Click="OnTrim" Tag="shot" Margin="0,0,10,8"
                        ToolTip="From just before the shot to just after the goal or your last touch" />
                <Button x:Name="GoalTrim" Style="{StaticResource SecondaryButton}" Content="Just the goal" Click="OnTrim" Tag="goal" Margin="0,0,10,8"
                        ToolTip="The 5 s before the goal and 2 s after" />
                <Button Style="{StaticResource SecondaryButton}" Content="Start here" Click="OnTrim" Tag="in" Margin="0,0,10,8"
                        ToolTip="Starts the clip where the player is now" />
                <Button Style="{StaticResource SecondaryButton}" Content="End here" Click="OnTrim" Tag="out" Margin="0,0,10,8"
                        ToolTip="Ends the clip where the player is now" />
                <Button Style="{StaticResource SecondaryButton}" Content="Whole clip" Click="OnTrim" Tag="all" Margin="0,0,10,8" />
              </WrapPanel>

              <StackPanel x:Name="Colours" Margin="0,14,0,0">
                <DockPanel>
                  <Border Style="{StaticResource SegmentBox}" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Natural" Style="{StaticResource Segment}" GroupName="Looks" Content="Natural" Click="OnLook" Tag="0,0,0,0" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Looks" Content="Vivid" Click="OnLook" Tag="5,20,50,5" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Looks" Content="Cinematic" Click="OnLook" Tag="-5,30,-25,30" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Looks" Content="Bright" Click="OnLook" Tag="30,10,15,0" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Looks" Content="Ice" Click="OnLook" Tag="0,15,10,-60" />
                    </StackPanel>
                  </Border>
                  <TextBlock Style="{StaticResource SliderName}" Text="Colours" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,30,0">
                    <DockPanel Margin="0,10,0,0">
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Brightness, StringFormat='{}{0:+0;-0;0}'}" />
                      <TextBlock Text="Brightness" />
                    </DockPanel>
                    <Slider x:Name="Brightness" Style="{StaticResource Range}" Minimum="-100" Maximum="100" TickFrequency="5" ValueChanged="OnColour"
                            AutomationProperties.Name="Brightness" />
                  </StackPanel>
                  <StackPanel>
                    <DockPanel Margin="0,10,0,0">
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Contrast, StringFormat='{}{0:+0;-0;0}'}" />
                      <TextBlock Text="Contrast" />
                    </DockPanel>
                    <Slider x:Name="Contrast" Style="{StaticResource Range}" Minimum="-100" Maximum="100" TickFrequency="5" ValueChanged="OnColour"
                            AutomationProperties.Name="Contrast" />
                  </StackPanel>
                  <StackPanel Margin="0,0,30,0">
                    <DockPanel Margin="0,16,0,0">
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Saturation, StringFormat='{}{0:+0;-0;0}'}" />
                      <TextBlock Text="Colour" />
                    </DockPanel>
                    <Slider x:Name="Saturation" Style="{StaticResource Range}" Minimum="-100" Maximum="100" TickFrequency="5" ValueChanged="OnColour"
                            AutomationProperties.Name="Colour strength" />
                  </StackPanel>
                  <StackPanel>
                    <DockPanel Margin="0,16,0,0">
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=Warmth, StringFormat='{}{0:+0;-0;0}'}" />
                      <TextBlock Text="Warmth" />
                    </DockPanel>
                    <Slider x:Name="Warmth" Style="{StaticResource Range}" Minimum="-100" Maximum="100" TickFrequency="5" ValueChanged="OnColour"
                            AutomationProperties.Name="Warmth" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
              <TextBlock x:Name="EditNote" Style="{StaticResource SliderHint}" Margin="0,18,0,0"
                          />
            </StackPanel>
          </Border>
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="10,6,10,12">
                <CheckBox x:Name="FavouritesOnly" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnFavouritesOnly"
                          AutomationProperties.Name="Favourites only" />
                <TextBlock Text="Favourites only" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl x:Name="ClipList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource ClipRow}" Checked="OnClip" AutomationProperties.Name="{Binding Shot}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE735;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Accent}"
                                   Margin="8,2,0,0" Visibility="{Binding Favourite, Converter={StaticResource Vis}}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Shot}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,3,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="NoFavourites" Style="{StaticResource MutedText}" FontSize="12.5" Margin="10,0,10,8" Visibility="Collapsed"
                         Text="No favourites yet. Pick a clip and press the star." />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
