<UserControl x:Class="Optimiser.HeatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,28">
      <TextBlock Style="{StaticResource MutedText}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left"
                 Text="Windows' own temperature sensors and MSI's fan speeds, a log of what was running whenever a sensor passed 90 °C, and a quiet profile that keeps the laptop cool on the desktop." />

      <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="Right now" Style="{StaticResource PanelTitle}" />
          <UniformGrid x:Name="Readings" Columns="4" />
          <TextBlock x:Name="NoReadings" Style="{StaticResource MutedText}" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap" />
          <TextBlock x:Name="FanNote" Style="{StaticResource MutedText}" FontSize="13" LineHeight="19" MaxWidth="720"
                     HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock x:Name="Lag" Foreground="{StaticResource Warn}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                     Text="The fans aren't keeping up: the temperature has climbed 5 °C in the last few seconds and they haven't sped up. Cooler Boost in MSI Center runs them at full speed." />
        </StackPanel>
      </Border>

      <TextBlock Text="Quiet and cool" Style="{StaticResource GroupTitle}" />
      <Border Style="{StaticResource Panel}" Padding="20,16">
        <DockPanel>
          <CheckBox x:Name="QuietSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="24,0,0,0" Click="OnQuiet"
                    VerticalAlignment="Center" AutomationProperties.Name="Quiet profile on the desktop" />
          <StackPanel>
            <TextBlock Text="Quiet profile on the desktop" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" LineHeight="19"
                       Text="While no game is running, the CPU's turbo boost is switched off and Windows' power mode goes to Best power efficiency, so the laptop runs cooler and the fans stay quiet. Both lift the moment a game from your Games list starts, and are put back exactly as they were when you turn this off or close Optimiser." />
            <TextBlock x:Name="QuietState" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Heat spikes" Style="{StaticResource GroupTitle}" />
      <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Button x:Name="ClearButton" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,16,0" Content="Clear" Click="OnClear" />
            <CheckBox x:Name="WatchSwitch" Style="{StaticResource Switch}" Click="OnWatch" AutomationProperties.Name="Watch for heat spikes" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Watch for heat spikes" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" LineHeight="19"
                       Text="Checks the sensors every 10 seconds while Optimiser runs. When one passes 90 °C it notes the time, the sensor and the five programs using the most CPU, so a spike at idle can be traced. It doesn't wake the graphics card." />
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="NoSpikes" Style="{StaticResource MutedText}" Margin="2,8,0,0" Text="No spikes logged yet." />
      <ItemsControl x:Name="SpikeList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Panel}" Padding="20,12" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="190" Text="{Binding Heading}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
