<Window x:Class="Optimiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimiser" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="14" UseLayoutRounding="True"
        Icon="Assets/optimiser.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <!-- Sidebar -->
    <DockPanel Grid.RowSpan="2" Background="{StaticResource Rail}">
      <Image DockPanel.Dock="Top" Source="Assets/optimiser.ico" Width="30" Height="30" Margin="0,10,0,18" />
      <StackPanel x:Name="Nav" WindowChrome.IsHitTestVisibleInChrome="True">
        <RadioButton Style="{StaticResource Nav}" Content="&#xE80F;" Tag="Dashboard" ToolTip="Dashboard" Checked="OnNav" />
        <RadioButton Style="{StaticResource Nav}" Content="&#xE945;" Tag="Optimisations" ToolTip="Optimisations" Checked="OnNav" />
        <RadioButton Style="{StaticResource Nav}" Content="&#xE7FC;" Tag="Games" ToolTip="Games" Checked="OnNav" />
        <RadioButton Style="{StaticResource Nav}" Content="&#xE9D9;" Tag="Stats" ToolTip="Stats" Checked="OnNav" />
        <RadioButton Style="{StaticResource Nav}" Content="&#xE81C;" Tag="Backups" ToolTip="Backups" Checked="OnNav" />
      </StackPanel>
    </DockPanel>

    <!-- Title bar: page name on the left, window buttons on the right; the rest drags the window -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimise" />
        <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximise" Click="OnMaximise" />
        <Button Style="{StaticResource CloseCaption}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose" />
      </StackPanel>
      <TextBlock x:Name="PageTitle" Margin="28,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                 Foreground="{StaticResource Accent}" />
    </DockPanel>

    <Grid x:Name="Pages" Grid.Row="1" Grid.Column="1" Margin="28,12,28,28">

      <ScrollViewer x:Name="Dashboard" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,32">
            <Grid Width="148" Height="148">
              <Path Data="M 26.62,121.38 A 67,67 0 1 1 121.38,121.38" Stroke="{StaticResource Line}" StrokeThickness="14"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel VerticalAlignment="Center" Margin="32,0,0,0">
              <TextBlock x:Name="Headline" Text="Scanning your PC" FontSize="34" FontWeight="SemiBold" />
              <TextBlock x:Name="Subline" Style="{StaticResource MutedText}" MaxWidth="560" Margin="0,8,0,0" FontSize="15" />
            </StackPanel>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Your PC" Style="{StaticResource PanelTitle}" />
                <Grid x:Name="Specs">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Processor" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                  <StackPanel Grid.Column="1" Margin="0,0,0,16">
                    <TextBlock x:Name="CpuName" TextWrapping="Wrap" />
                    <TextBlock x:Name="CpuCores" Style="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="Graphics" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GpuNames" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="2" Text="Memory" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Ram" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="3" Text="Machine" Style="{StaticResource MutedText}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Machine" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Tuned for this PC" Style="{StaticResource PanelTitle}" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,16"
                           Text="Optimiser only offers the tweaks that fit the hardware it found." />
                <StackPanel x:Name="Features" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="Optimisations" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource MutedText}" FontSize="15"
                   Text="The tweaks arrive in step 2. Each one gets its own switch here, and only the ones that fit this PC are shown." />
      </StackPanel>

      <StackPanel x:Name="Games" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource MutedText}" FontSize="15"
                   Text="Game detection arrives in step 4. Optimiser will find your Steam and Epic games and switch to a gaming profile whenever one starts." />
      </StackPanel>

      <StackPanel x:Name="Stats" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource MutedText}" FontSize="15"
                   Text="Live temperatures, usage and clock speeds arrive in step 3." />
      </StackPanel>

      <DockPanel x:Name="Backups" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
          <TextBlock Style="{StaticResource MutedText}" FontSize="15" MaxWidth="640" HorizontalAlignment="Left"
                     Text="Optimiser saves every setting before it changes it, so you can put things back one at a time or all at once. A Windows restore point is also made before the first change." />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="UndoAllButton" Style="{StaticResource AccentButton}" Content="Undo all changes" Click="OnUndoAll" />
            <Button Style="{StaticResource SecondaryButton}" Content="Create restore point" Margin="10,0,0,0" Click="OnRestorePoint" />
          </StackPanel>
          <TextBlock x:Name="BackupStatus" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
        </StackPanel>
        <Grid>
          <TextBlock x:Name="NoChanges" Style="{StaticResource MutedText}"
                     Text="Nothing has been changed yet. When you switch on an optimisation, its original setting appears here." />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChangeList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="13"
                                 Text="{Binding At, Mode=OneWay, StringFormat='{}{0:d MMM, HH:mm}'}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Tweak, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,4,0,0">
                          <Run Text="{Binding Key, Mode=OneWay}" />\<Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>

    </Grid>
  </Grid>
</Window>
