<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\optimiser.ico</ApplicationIcon>
    <StartupObject>Optimiser.Program</StartupObject>
    <!-- Startup hooks would let a DOTNET_STARTUP_HOOKS variable in the user's environment run code in this admin app -->
    <StartupHookSupport>false</StartupHookSupport>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\optimiser.ico" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
